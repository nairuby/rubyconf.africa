<!DOCTYPE html>
<html lang="en">
{% include archive/head.liquid %}
<body>
<div class="page-wrapper">
    <!-- Header and Navigation-->
    {% include archive/navigation.liquid %}

    <!-- Content -->
    <div class="content-wrapper">
        {% if content and content != "" %}
            {{ content }}
        {% else %}
            {% assign speaker = page.speaker | default: page %}
            <!-- Speaker Detail -->
            <section class="speaker-detail">
              <div class="auto-container">
                <div class="row">
                  <div class="image-column col-lg-4 col-md-12 col-sm-12">
                    <div class="image-box">
                      <figure class="image">
                        <img src="{{ speaker.image }}" alt="{{ speaker.name }}" />
                      </figure>
                      <ul class="social-icon-two social-icon-colored text-center">
                        {% if speaker.twitter and speaker.twitter != "" %}
                        <li>
                          <a href="{{ speaker.twitter }}" target="_blank"><i class="fa-brands fa-x-twitter"></i></a>
                        </li>
                        {% endif %}
                        {% if speaker.linkedin and speaker.linkedin != "" %}
                        <li>
                          <a href="{{ speaker.linkedin }}" target="_blank"><i class="fab fa-linkedin"></i></a>
                        </li>
                        {% endif %}
                        {% if speaker.website and speaker.website != "" %}
                        <li>
                          <a href="{{ speaker.website }}" target="_blank"><i class="fab fa-sistrix"></i></a>
                        </li>
                        {% endif %}
                      </ul>
                    </div>
                  </div>

                  <div class="info-column col-lg-8 col-md-12 col-sm-12">
                    <div class="card shadow-sm">
                      <div class="card-body">
                        <h3 class="card-title text-info-emphasis">{{ speaker.name }}</h3>
                        <h5 class="text-secondary font-weight-bold">{{ speaker.bio }}</h5>
                        <p class="card-text text-black">{{ speaker.details }}</p>
                        {% if speaker.talk_title and speaker.talk_title != "" %}
                        <h4 class="mt-4 text-info-emphasis">Talk by {{ speaker.name }}</h4>
                        <div class="border p-3 bg-white rounded shadow-sm mt-2">
                          <p class="font-weight-bold text-info-emphasis">{{ speaker.talk_title }}</p>
                          {% if speaker.talk_description and speaker.talk_description != "" and speaker.talk_description != "TBA" %}
                          <div class="text-info-emphasis">{{ speaker.talk_description }}</div>
                          {% endif %}
                        </div>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </section>
            <!--End Speaker Detail -->
        {% endif %}
    </div>

    <!-- Footer -->
    {% include archive/footer.liquid %}
</div>

<!--Scroll to top-->
<div class="scroll-to-top scroll-to-target" data-target="html"><span class="fa fa-angle-double-up"></span></div>
{% include js.liquid %}
</body>
</html>
