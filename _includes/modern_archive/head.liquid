<head>
	<meta charset="utf-8"/>
	<title>{{ page.title | default: "Ruby Conf Africa 2026 — Archive" }}</title>
	<meta name="description" content="{{ page.description | default: "Ruby Conference Africa 2026 held on August 21 - 22, 2026 in Nairobi, Kenya. Beyond code: Innovating for the future." }}"/>

	<!-- Favicon -->
	<link rel="icon" href="{{ '/images/favicon.ico' | prepend: site.baseurl }}" type="image/x-icon"/>
	<link rel="icon" type="image/png" sizes="16x16" href="{{ '/images/favicons/favicon-16x16.png' | prepend: site.baseurl }}"/>
	<link rel="icon" type="image/png" sizes="32x32" href="{{ '/images/favicons/favicon-32x32.png' | prepend: site.baseurl }}"/>
	<link rel="apple-touch-icon" sizes="180x180" href="{{ '/images/favicons/apple-touch-icon.png' | prepend: site.baseurl }}"/>
	<link rel="manifest" href="{{ '/site.webmanifest' | prepend: site.baseurl }}"/>

	<!-- Modern Tailwind CSS -->
	<link href="{{ site.baseurl }}/assets/modern_archive/css/main.css" rel="stylesheet" />
	
	<!-- Font Awesome for icons -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

	<!-- Modern JavaScript -->
	<script src="{{ site.baseurl }}/assets/modern_archive/js/bundle.js" defer></script>

	{% include google_analytics.liquid %}

	<!-- Meta Tags for Responsive Design -->
	<meta http-equiv="X-UA-Compatible" content="IE=edge"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

	<!-- Open Graph meta tags -->
	<meta property="og:title" content="{{ page.title | default: 'Ruby Conf Africa 2026' }}"/>
	<meta property="og:description" content="{{ page.description | default: 'Ruby Conf Africa 2026 archive - Nairobi, Kenya.' }}"/>
	<meta property="og:image" content="https://rubyconf.africa/images/og_rubyconf2.png"/>
	<meta property="og:url" content="{{ page.url | absolute_url | default: site.url }}"/>
	<meta property="og:type" content="website"/>
</head>
