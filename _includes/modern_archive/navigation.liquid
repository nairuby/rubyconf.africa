<!-- Modern Archive Navigation with Tailwind responsive design -->
<nav class="bg-white shadow-lg sticky top-0 z-50" role="navigation" aria-label="Main archive navigation">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">

            <!-- Logo & Year Badge -->
            <div class="flex-shrink-0 flex items-center space-x-3">
                <a href="{{ site.baseurl }}/2026/"
                   class="flex items-center text-xl font-bold text-red-600 hover:text-red-700 transition-colors duration-200"
                   aria-label="Ruby Conf Africa 2026 Archive Home">
                    <img src="{{ '/images/logo/arc_logo_coloured.png' | prepend: site.baseurl }}"
                         alt="Africa Ruby Community Logo"
                         class="h-8 w-auto"
                         width="120"
                         height="32"
                         loading="lazy">
                </a>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-800">
                    2026 Archive
                </span>
            </div>

            <!-- Desktop Navigation -->
            <div class="hidden md:flex items-center space-x-1">
                <a href="{{ site.baseurl }}/2026/"
                   class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 hover:text-red-600 hover:bg-red-50 transition-all duration-200"
                   {% if page.url == "/2026/" or page.url == "/2026/index.html" %}aria-current="page"{% endif %}>
                    Home
                </a>

                <a href="{{ site.baseurl }}/2026/schedule"
                   class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 hover:text-red-600 hover:bg-red-50 transition-all duration-200"
                   {% if page.url contains "/2026/schedule" %}aria-current="page"{% endif %}>
                    Schedule
                </a>

                <a href="{{ site.baseurl }}/2026/about-us"
                   class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 hover:text-red-600 hover:bg-red-50 transition-all duration-200"
                   {% if page.url contains "/2026/about-us" %}aria-current="page"{% endif %}>
                    About
                </a>

                <a href="{{ site.baseurl }}/2026/speakers"
                   class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 hover:text-red-600 hover:bg-red-50 transition-all duration-200"
                   {% if page.url contains "/2026/speakers" %}aria-current="page"{% endif %}>
                    Speakers
                </a>


                <!-- Essentials Dropdown -->
                <div class="relative group">
                    <button class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 hover:text-red-600 hover:bg-red-50 transition-all duration-200 flex items-center"
                            aria-expanded="false" aria-haspopup="true">
                        Essentials
                        <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </button>
                    <div class="absolute right-0 mt-1 w-48 bg-white rounded-md shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 border border-gray-200 z-50">
                        <div class="py-1">
                            <a href="{{ site.baseurl }}/2026/practicalities"
                               class="block px-4 py-2 text-sm text-gray-700 hover:bg-red-50 hover:text-red-600">Attendee Guide</a>
                            <a href="{{ site.baseurl }}/2026/code-of-conduct"
                               class="block px-4 py-2 text-sm text-gray-700 hover:bg-red-50 hover:text-red-600">Code of Conduct</a>
                        </div>
                    </div>
                </div>

                <!-- Past Events Dropdown -->
                <div class="relative group">
                    <button class="px-3 py-2 rounded-md text-sm font-semibold text-red-600 hover:bg-red-50 transition-all duration-200 flex items-center"
                            aria-expanded="false" aria-haspopup="true">
                        <i class="fas fa-history mr-1.5"></i>
                        Past Events
                        <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </button>
                    <div class="absolute right-0 mt-1 w-48 bg-white rounded-md shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 border border-gray-200 z-50">
                        <div class="py-1">
                            <a href="{{ site.baseurl }}/" class="block px-4 py-2 text-sm font-bold text-red-600 hover:bg-red-50">Current Site</a>
                            <div class="border-t border-gray-100 my-1"></div>
                            {% for archive_year in site.data.conference.archive_years %}
                              <a href="{{ site.baseurl }}{{ archive_year.path }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-red-50 hover:text-red-600">{{ archive_year.label }} Archive</a>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile menu button -->
            <div class="md:hidden flex items-center">
                <button type="button"
                        id="mobile-menu-button-2026"
                        onclick="document.getElementById('mobile-menu-2026').classList.toggle('hidden')"
                        class="inline-flex items-center justify-center p-2 rounded-md text-gray-700 hover:text-red-600 hover:bg-gray-100 focus:outline-none"
                        aria-controls="mobile-menu-2026"
                        aria-expanded="false">
                    <span class="sr-only">Open main menu</span>
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Menu -->
    <div class="hidden md:hidden border-t border-gray-200" id="mobile-menu-2026">
        <div class="px-2 pt-2 pb-3 space-y-1">
            <a href="{{ site.baseurl }}/2026/" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-red-600 hover:bg-red-50">Home</a>
            <a href="{{ site.baseurl }}/2026/schedule" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-red-600 hover:bg-red-50">Schedule</a>
            <a href="{{ site.baseurl }}/2026/about-us" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-red-600 hover:bg-red-50">About</a>
            <a href="{{ site.baseurl }}/2026/speakers" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-red-600 hover:bg-red-50">Speakers</a>
            <a href="{{ site.baseurl }}/2026/contact" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-red-600 hover:bg-red-50">Contact</a>
            <a href="{{ site.baseurl }}/2026/practicalities" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-red-600 hover:bg-red-50">Attendee Guide</a>
            <a href="{{ site.baseurl }}/2026/code-of-conduct" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-red-600 hover:bg-red-50">Code of Conduct</a>
            <div class="border-t border-gray-200 pt-2 font-semibold text-xs text-gray-400 px-3 uppercase tracking-wider">Past Events</div>
            <a href="{{ site.baseurl }}/" class="block px-3 py-2 rounded-md text-base font-bold text-red-600 hover:bg-red-50">Current Site</a>
            {% for archive_year in site.data.conference.archive_years %}
              <a href="{{ site.baseurl }}{{ archive_year.path }}" class="block px-3 py-2 rounded-md text-base font-medium text-gray-600 hover:text-red-600 hover:bg-red-50">{{ archive_year.label }} Archive</a>
            {% endfor %}
        </div>
    </div>
</nav>
